{
  "$schema": "skills/factory/factory.schema.json",
  "codingAgent": "claude-code",
  "conventions": "AGENTS.md",
  "glossary": "CONTEXT.md",
  "decisionRecords": ["docs/adr/", "docs/grilling/", "docs/prd/"],
  "issueTemplate": ".github/ISSUE_TEMPLATE/task.md",
  "setup": "pnpm install",
  "validate": "pnpm validate",
  "maxChangedLines": 300,
  "harnessLog": "docs/harness-log.md",
  "labels": {
    "ready": "ready-for-agent",
    "needsInfo": "needs-info",
    "friction": "friction",
    "preExisting": "pre-existing"
  },
  "testFiles": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test-*.ts",
    "**/test-*.tsx",
    "**/test-*.sh",
    "**/vitest.config.ts",
    "**/vitest.setup.ts",
    "**/__snapshots__/**"
  ],
  "riskTiers": [
    {
      "tier": "high",
      "paths": [
        "infra/**",
        ".github/workflows/**",
        "apps/server/src/db/**",
        "apps/server/src/prompts/**",
        "apps/**/*auth*",
        "apps/**/*auth*/**",
        "apps/**/*sign-in*",
        "apps/**/*sign-in*/**",
        "apps/**/*invite*",
        "apps/**/*invite*/**",
        "apps/**/*email*",
        "apps/**/*email*/**",
        "apps/**/*profile*",
        "apps/**/*profile*/**",
        "apps/**/*moderation*",
        "apps/**/*moderation*/**",
        ".claude/**",
        ".agents/**",
        "tools/harness/**"
      ]
    },
    {
      "tier": "low",
      "paths": [
        "docs/**",
        "**/*.md",
        ".github/ISSUE_TEMPLATE/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        ".oxlintrc.json",
        ".oxfmtrc.jsonc",
        "lefthook.yml",
        "stylelint.config.mjs"
      ]
    },
    { "tier": "medium", "paths": ["**"] }
  ]
}
