{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    // Skills are installed from upstream (see skills-lock.json); keep them byte-identical.
    ".agents/",
    // Generated by Figma Make and kept as a reference only.
    "docs/design/figma-make-export/",
    // Generated by drizzle-kit, which reads them back; keep them as it writes them.
    "apps/server/src/db/migrations/",
  ],
}
