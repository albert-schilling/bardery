{
  "extends": "../../tsconfig.base.json",
  "include": ["**/*", ".react-router/types/**/*"],
  "exclude": ["build"],
  "compilerOptions": {
    // Only APIs that Vite's default browser target (Baseline widely available) supports without polyfills.
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["vite/client"],
    // Nothing is emitted; Vite transpiles for the browsers.
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Lets route modules import their generated types from `./+types/<route>`.
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      // The server's router imports through its own `~/routers`; only that folder is mapped, so a mistyped
      // `~/` import in the web app can't resolve to server code.
      "~/routers": ["../server/src/routers/index.ts"],
      "~/routers/*": ["../server/src/routers/*"],
      "~/*": ["./src/*"]
    },
    "noEmit": true
  }
}
