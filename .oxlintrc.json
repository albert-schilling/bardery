{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    // Enables rules that need type information, through oxlint-tsgolint.
    "typeAware": true,
    // Warnings fail `pnpm lint`, so they get fixed instead of piling up.
    "denyWarnings": true,
    // A disable comment that no longer suppresses anything is an error.
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      // Apps import across folders by the `~/` alias, so moving a file doesn't break its imports.
      "files": ["apps/**"],
      "plugins": ["import"],
      "rules": { "import/no-relative-parent-imports": "error" }
    },
    // Every file of the server, including those outside the layer folders. The layer overrides below
    // repeat this pattern, because a rule set in a later override replaces an earlier one.
    {
      "files": ["apps/server/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    // The server's layers, as decided in docs/grilling/2026-09-24-technical-session.md, Backend section.
    // Imports go one way: routers → services → repositories, providers and domain; jobs → services;
    // repositories → db, for the schema their queries use. Every other folder imports nothing, until
    // that decision says otherwise.
    {
      "files": ["apps/server/src/routers/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              },
              {
                "group": ["~/**", "!~/routers", "!~/routers/**", "!~/services", "!~/services/**"],
                "message": "routers/ may import only services/ (see the server's layers in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              },
              {
                "group": [
                  "~/**",
                  "!~/services",
                  "!~/services/**",
                  "!~/repositories",
                  "!~/repositories/**",
                  "!~/providers",
                  "!~/providers/**",
                  "!~/domain",
                  "!~/domain/**"
                ],
                "message": "services/ may import only repositories/, providers/ and domain/ (see the server's layers in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/repositories/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              },
              {
                "group": ["~/**", "!~/repositories", "!~/repositories/**", "!~/db", "!~/db/**"],
                "message": "repositories/ may import only db/ (see the server's layers in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/providers/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              },
              {
                "group": ["~/**", "!~/providers", "!~/providers/**"],
                "message": "providers/ imports no other folder (see the server's layers in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/jobs/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              },
              {
                "group": ["~/**", "!~/jobs", "!~/jobs/**", "!~/services", "!~/services/**"],
                "message": "jobs/ may import only services/ (see the server's layers in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/prompts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              },
              {
                "group": ["~/**", "!~/prompts", "!~/prompts/**"],
                "message": "prompts/ imports no other folder (see the server's layers in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/db/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              },
              {
                "group": ["~/**", "!~/db", "!~/db/**"],
                "message": "db/ imports no other folder (see the server's layers in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@bardery/**",
                  "!@bardery/schemas",
                  "!@bardery/schemas/**",
                  "!@bardery/utils",
                  "!@bardery/utils/**",
                  "!@bardery/i18n",
                  "!@bardery/i18n/**"
                ],
                "message": "The server may import only @bardery/schemas, utils and i18n (see the package rules in .oxlintrc.json)."
              },
              {
                "group": ["~/**", "!~/domain", "!~/domain/**"],
                "message": "domain/ imports no other folder (see the server's layers in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    // The packages' allowed dependencies, as decided in docs/grilling/2026-09-24-technical-session.md,
    // Repo and tooling section: schemas → utils; the server uses schemas, utils and i18n only.
    // The same rules sit in the Nx tags of each project.json. The server's allowlist is the first server
    // override above, repeated in each layer override.
    {
      "files": ["packages/shared/schemas/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@bardery/**", "!@bardery/utils"],
                "message": "schemas may import only @bardery/utils (see the package rules in .oxlintrc.json)."
              }
            ]
          }
        ]
      }
    },
    // The web app gets the server's router type for its tRPC client and nothing else from the server:
    // `import type` passes, any import that exists at runtime fails.
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@bardery/server", "@bardery/server/**"],
                "allowTypeImports": true,
                "message": "The web app may only `import type` from the server, never runtime code."
              },
              {
                // The `~/routers` alias exists in the web app's tsconfig only so it can typecheck the server's router.
                "group": ["~/routers", "~/routers/**"],
                "message": "The web app imports the server's router only as a type, from @bardery/server/router."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    // Generated by Figma Make and kept as a reference only.
    "docs/design/figma-make-export/"
  ]
}
